space, L) Ensure that a real MRRR workspace can solve a system of size L. Arguments Type Intent Optional Attributes Name type( diag_workspace_t ), intent(inout) :: workspace integer, intent(in) :: L Called by proc~~ensure_real_workspace~~CalledByGraph proc~ensure_real_workspace ensure_real_workspace proc~diagonalize_open_tridiagonal diagonalize_open_tridiagonal proc~diagonalize_open_tridiagonal->proc~ensure_real_workspace proc~diagonalize_symmetric_real_partial diagonalize_symmetric_real_partial proc~diagonalize_symmetric_real_partial->proc~ensure_real_workspace proc~ensure_complex_workspace ensure_complex_workspace proc~ensure_complex_workspace->proc~ensure_real_workspace proc~diagonalize_hermitian_complex_partial diagonalize_hermitian_complex_partial proc~diagonalize_hermitian_complex_partial->proc~ensure_complex_workspace proc~diagonalize_open_tridiagonal_complex diagonalize_open_tridiagonal_complex proc~diagonalize_open_tridiagonal_complex->proc~diagonalize_open_tridiagonal proc~diagonalize_symmetric_real diagonalize_symmetric_real proc~diagonalize_symmetric_real->proc~diagonalize_symmetric_real_partial proc~diagonalize_symmetric_real_values_only diagonalize_symmetric_real_values_only proc~diagonalize_symmetric_real_values_only->proc~diagonalize_symmetric_real_partial program~benchmark_partial_diagonalization benchmark_partial_diagonalization program~benchmark_partial_diagonalization->proc~diagonalize_open_tridiagonal program~benchmark_partial_diagonalization->proc~diagonalize_symmetric_real proc~diagonalize_hermitian_complex diagonalize_hermitian_complex proc~diagonalize_hermitian_complex->proc~diagonalize_hermitian_complex_partial proc~diagonalize_hermitian_complex_values_only diagonalize_hermitian_complex_values_only proc~diagonalize_hermitian_complex_values_only->proc~diagonalize_hermitian_complex_partial proc~run_kohn_sham_scf_common run_kohn_sham_scf_common proc~run_kohn_sham_scf_common->proc~diagonalize_hermitian_complex_partial proc~run_kohn_sham_scf_common->proc~diagonalize_open_tridiagonal_complex Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine ensure_real_workspace ( workspace , L ) type ( diag_workspace_t ), intent ( inout ) :: workspace integer , intent ( in ) :: L if (. not . allocated ( workspace % work ) . or . size ( workspace % work ) /= 26 * L ) then if ( allocated ( workspace % work )) deallocate ( workspace % work ) allocate ( workspace % work ( max ( 1 , 26 * L ))) end if if (. not . allocated ( workspace % iwork ) . or . size ( workspace % iwork ) /= 10 * L ) then if ( allocated ( workspace % iwork )) deallocate ( workspace % iwork ) allocate ( workspace % iwork ( max ( 1 , 10 * L ))) end if if (. not . allocated ( workspace % isuppz ) . or . size ( workspace % isuppz ) /= 2 * L ) then if ( allocated ( workspace % isuppz )) deallocate ( workspace % isuppz ) allocate ( workspace % isuppz ( max ( 2 , 2 * L ))) end if if (. not . allocated ( workspace % d ) . or . size ( workspace % d ) /= L ) then if ( allocated ( workspace % d )) deallocate ( workspace % d ) allocate ( workspace % d ( L )) end if if (. not . allocated ( workspace % e ) . or . size ( workspace % e ) /= max ( 1 , L - 1 )) then if ( allocated ( workspace % e )) deallocate ( workspace % e ) allocate ( workspace % e ( max ( 1 , L - 1 ))) end if end subroutine ensure_real_workspace","tags":"","url":"proc/ensure_real_workspace.html"},{"title":"ensure_complex_workspace – LSDA-Hubbard-Fortran","text":"private  subroutine ensure_complex_workspace(workspace, L) Ensure that a complex Hermitian MRRR workspace can solve size L. Arguments Type Intent Optional Attributes Name type( diag_workspace_t ), intent(inout) :: workspace integer, intent(in) :: L Calls proc~~ensure_complex_workspace~~CallsGraph proc~ensure_complex_workspace ensure_complex_workspace proc~ensure_real_workspace ensure_real_workspace proc~ensure_complex_workspace->proc~ensure_real_workspace Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~ensure_complex_workspace~~CalledByGraph proc~ensure_complex_workspace ensure_complex_workspace proc~diagonalize_hermitian_complex_partial diagonalize_hermitian_complex_partial proc~diagonalize_hermitian_complex_partial->proc~ensure_complex_workspace proc~diagonalize_hermitian_complex diagonalize_hermitian_complex proc~diagonalize_hermitian_complex->proc~diagonalize_hermitian_complex_partial proc~diagonalize_hermitian_complex_values_only diagonalize_hermitian_complex_values_only proc~diagonalize_hermitian_complex_values_only->proc~diagonalize_hermitian_complex_partial proc~run_kohn_sham_scf_common run_kohn_sham_scf_common proc~run_kohn_sham_scf_common->proc~diagonalize_hermitian_complex_partial proc~run_kohn_sham_scf_complex run_kohn_sham_scf_complex proc~run_kohn_sham_scf_complex->proc~run_kohn_sham_scf_common proc~run_kohn_sham_scf_real run_kohn_sham_scf_real proc~run_kohn_sham_scf_real->proc~run_kohn_sham_scf_common Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine ensure_complex_workspace ( workspace , L ) type ( diag_workspace_t ), intent ( inout ) :: workspace integer , intent ( in ) :: L call ensure_real_workspace ( workspace , L ) if (. not . allocated ( workspace % cwork ) . or . size ( workspace % cwork ) /= 2 * L ) then if ( allocated ( workspace % cwork )) deallocate ( workspace % cwork ) allocate ( workspace % cwork ( max ( 1 , 2 * L ))) end if if (. not . allocated ( workspace % rwork ) . or . size ( workspace % rwork ) /= 24 * L ) then if ( allocated ( workspace % rwork )) deallocate ( workspace % rwork ) allocate ( workspace % rwork ( max ( 1 , 24 * L ))) end if end subroutine ensure_complex_workspace","tags":"","url":"proc/ensure_complex_workspace.html"},{"title":"diagonalize_open_tridiagonal – LSDA-Hubbard-Fortran","text":"public  subroutine diagonalize_open_tridiagonal(potential, L, n_vec, eigvals, eigvecs, workspace, ierr) Diagonalize an open-chain tridiagonal Hamiltonian using DSTEVR. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: potential (:) integer, intent(in) :: L integer, intent(in) :: n_vec real(kind=dp), intent(out) :: eigvals (:) real(kind=dp), intent(out) :: eigvecs (:,:) type( diag_workspace_t ), intent(inout) :: workspace integer, intent(out) :: ierr Calls proc~~diagonalize_open_tridiagonal~~CallsGraph proc~diagonalize_open_tridiagonal diagonalize_open_tridiagonal interface~dstevr DSTEVR proc~diagonalize_open_tridiagonal->interface~dste